{
    "name": "hakone/extended-http-server-middleware",
    "description": "PSR-7 message implementation with all method calls restricted",
    "license": "Apache-2.0",
    "require": {
        "php": "^8.2",
        "hakone/untouchable-psr7": "^0.2.0",
        "psr/http-server-middleware": "^1.0"
    },
    "require-dev": {
        "bamarni/composer-bin-plugin": "^1.9"
    },
    "autoload": {
        "psr-4": {
            "Hakone\\Http\\Server\\": "src"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "bamarni/composer-bin-plugin": true
        }
    },
    "extra": {
        "bamarni-bin": {
            "bin-links": true,
            "forward-command": true
        }
    }
}
